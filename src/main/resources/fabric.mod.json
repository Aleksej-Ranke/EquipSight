{
  "schemaVersion": 1,
  "id": "equipsight",
  "version": "${version}",
  "name": "EquipSight",
  "description": "A client-side mod that displays armor and hand items with durability on the HUD.",
  "authors": [
    "Jules"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/equipsight/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.alek.equipsight.EquipSightClient"
    ],
    "modmenu": [
        "de.alek.equipsight.EquipSightModMenu"
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
